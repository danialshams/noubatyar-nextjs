{
  "name": "noubatyar-nextjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:constraints": "tsx scripts/apply-constraints.ts",
    "test:core": "node --experimental-strip-types --test src/tests/scheduling.node.test.mjs",
    "test:db": "tsx --test src/tests/integration.db.test.ts",
    "check": "npm run db:generate && npm run lint && npm run test:core && npm test && npm run build"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^3.25.76",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "7.10.1",
    "typescript": "^5.9.3",
    "tsx": "^4.19.0",
    "vitest": "^3.2.4",
    "@types/pg": "^8.15.5",
    "dotenv": "^16.6.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "type": "module"
}
